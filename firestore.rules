rules_version = '2';

// Firestore security rules — HARDENED (role-enforced).
//
// Deploy with: firebase deploy --only firestore:rules   (run `firebase login` first)
// Or paste into Firebase Console → Firestore Database → Rules → Publish.
//
// ⚠️ REVIEW & TEST BEFORE DEPLOYING (Console "Rules Playground" or the emulator):
//   • Writes now require an admin/super_admin role (read from users/{uid}.role).
//     Regular signed-in users can no longer write team/timeline/photo/vanstring data
//     or escalate their own role.
//   • Username login performs an UNAUTHENTICATED lookup of the users collection.
//     These rules DISABLE that (users are no longer world-readable). Log in with
//     EMAIL, or change the users `read` rule to `if true` to keep username login.
//   • Client-side seeding/migration (team seed, founders migration, vanstring seed)
//     only succeeds while an admin is signed in. Existing data is unaffected.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Role helpers ───────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'anonymous';
    }
    function isAdmin()      { return myRole() in ['admin', 'super_admin']; }
    function isSuperAdmin() { return myRole() == 'super_admin'; }

    // Role an email is allowed to hold — mirrors ensureFirestoreUser() in code.
    function roleForEmail(email) {
      return email == 'iscurt.w@gmail.com' ? 'super_admin'
        : (email in ['on3keymusic@gmail.com', 'vanstringscm@gmail.com']) ? 'admin'
        : 'user';
    }
    function isOwnerDoc() {
      return resource.data.email == 'iscurt.w@gmail.com';
    }

    // ── Public content: anyone reads, only admins write ────────────
    match /teamMembers/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /vanstring/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Activity logs: admin-only and append-only ──────────────────
    match /logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Users ──────────────────────────────────────────────────────
    match /users/{userId} {
      // A user can read their own doc; admins can read all (dashboard user list).
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      // Create: bootstrap your OWN doc with your entitled role (no self-escalation),
      // or an admin creates another user (only super_admin may mint a super_admin).
      allow create: if
        (request.auth.uid == userId
          && request.resource.data.role == roleForEmail(request.auth.token.email))
        || (isAdmin() && request.resource.data.role != 'super_admin')
        || isSuperAdmin();

      // Update: super_admin → anything; admins → non-owner users but cannot grant
      // super_admin; a user → own doc without changing role or isActive.
      allow update: if isSuperAdmin()
        || (isAdmin() && !isOwnerDoc() && request.resource.data.role != 'super_admin')
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.isActive == resource.data.isActive);

      // Delete: admins may delete non-owner users; the owner can never be deleted.
      allow delete: if isAdmin() && !isOwnerDoc();
    }

    // ── Default deny ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
