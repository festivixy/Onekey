rules_version = '2';

// Firebase Storage security rules — HARDENED (admin-only writes).
//
// Deploy with: firebase deploy --only storage
// Or paste into Firebase Console → Storage → Rules → Publish.
//
// ⚠️ Uploads now require an admin/super_admin role (read from Firestore users/{uid}.role),
//    matching firestore.rules. Reads stay public so images render on the site.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
             in ['admin', 'super_admin'];
    }
    function validImage() {
      return request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Photos uploaded via the admin Photo Manager
    match /photos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
    }

    // Team member photos uploaded from the admin panel
    match /team/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
    }

    // Generic image uploads (timeline event photos, team crops via uploadImage)
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
    }

    // Anything else: public read, no write
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
